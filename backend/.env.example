# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediavault?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Uploads ---
MAX_FILE_SIZE_MB=200
DEFAULT_STORAGE_LIMIT_GB=10

# --- Storage provider: local | s3 | supabase | cloudinary ---
STORAGE_PROVIDER=local

# Local storage (default, works out of the box)
LOCAL_UPLOAD_DIR=uploads
LOCAL_PUBLIC_URL=http://localhost:4000/files

# AWS S3 (used when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Supabase Storage (used when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=mediavault

# Cloudinary (used when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (password reset). Leave blank in dev to log reset links to console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediaVault <no-reply@mediavault.app>
